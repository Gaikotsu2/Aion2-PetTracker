<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\data\opcodes.default.json" Link="data\opcodes.default.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\pets.json" Link="data\pets.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\pet-names.txt" Link="data\pet-names.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="SharpPcap" Version="6.3.1" />
  </ItemGroup>

</Project>
