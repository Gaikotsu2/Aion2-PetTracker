<Window x:Class="PetTracker.App.Views.MainWindow" Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aion 2 Pet Tracker" Width="820" Height="680" MinWidth="640" MinHeight="420"
        Background="{StaticResource SolidPanelBrush}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PetItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource RowAltBrush}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewMode" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditMode" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PetRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" MinWidth="170" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding IsPinned}" ToolTip="Pin to overlay" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Style="{StaticResource ViewMode}">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Style="{StaticResource Cell}" />
                        <TextBlock Text="{Binding Id, StringFormat=' #{0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <Button Content="rename" Style="{StaticResource TinyButton}" Margin="8,0,0,0" Command="{Binding BeginRenameCommand}" />
                        <TextBlock Text="needs resync" Foreground="{StaticResource WarnBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding NeedsResync, Converter={StaticResource BoolToVis}}"
                                   ToolTip="An update did not add up. The next login snapshot will fix it." />
                    </StackPanel>
                    <Grid Style="{StaticResource EditMode}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EditBox" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                 IsVisibleChanged="EditBox_IsVisibleChanged">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CommitRenameCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                            <Button Content="save" Style="{StaticResource TinyButton}" Command="{Binding CommitRenameCommand}" />
                            <Button Content="cancel" Style="{StaticResource TinyButton}" Margin="4,0,0,0" Command="{Binding CancelRenameCommand}" />
                        </StackPanel>
                        <Popup IsOpen="{Binding HasSuggestions, Mode=OneWay}" PlacementTarget="{Binding ElementName=EditBox}"
                               Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                            <Border Background="{StaticResource SolidPanelBrush}" BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="1" Padding="2" MinWidth="220">
                                <ItemsControl ItemsSource="{Binding Suggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,1"
                                                    Command="{Binding DataContext.PickSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>

                <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="3" Padding="5,0" Margin="0,0,4,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SpecialBackBrush}" />
                                    <Setter Property="ToolTip" Value="{Binding SpecialTooltip}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Genus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SpecialBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding LevelText}" Style="{StaticResource Cell}" FontWeight="SemiBold" />

                <Grid Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Style="{StaticResource PetBar}" Value="{Binding ProgressFraction, Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" HorizontalAlignment="Right" Style="{StaticResource Cell}" />
                </Grid>

                <TextBlock Grid.Column="5" Text="{Binding RegisteredText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="{Binding SessionGains, StringFormat='+{0}'}" Style="{StaticResource Cell}"
                           Foreground="{StaticResource GoodBrush}" />
                <Button Grid.Column="7" Content="&#x2197;" Style="{StaticResource TinyButton}" Command="{Binding OpenLinkCommand}" ToolTip="{Binding LinkTooltip}" HorizontalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- summary header -->
        <DockPanel Grid.Row="0">
            <Border DockPanel.Dock="Right" Background="{Binding Overlay.StatusBrush}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="White" />
            </Border>
            <StackPanel>
                <TextBlock Text="{Binding SummaryText}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SpecialText}" Foreground="{StaticResource SpecialBrush}" Margin="0,2,0,0" ToolTip="Special pets are not counted in Collection Status" />
                <TextBlock Text="{Binding LevelText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- capture problem (for example Npcap missing) -->
        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="#33E5B341" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                Visibility="{Binding HasCaptureProblem, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Get Npcap (npcap.com)" Command="{Binding OpenNpcapCommand}" Margin="10,0,0,0"
                        Visibility="{Binding ShowNpcapBanner, Converter={StaticResource BoolToVis}}" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                    <Run Text="Live capture is not running: " FontWeight="SemiBold" /><Run Text="{Binding CaptureProblem, Mode=OneWay}" />
                    <Run Text=" The collection below is the last saved state." />
                </TextBlock>
            </DockPanel>
        </Border>

        <ListBox Grid.Row="2" Margin="0,10,0,6" Style="{StaticResource Chips}" ItemsSource="{Binding TabOptions}" SelectedItem="{Binding SelectedTab}" />

        <!-- collection tab -->
        <Grid Grid.Row="3" Visibility="{Binding IsCollectionTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="clear filters" Command="{Binding ClearFiltersCommand}" Margin="8,0,0,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ShownText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by name, #id or genus" />
                </DockPanel>
                <WrapPanel>
                    <TextBlock Text="Genus" Style="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding GenusOptions}" SelectedItem="{Binding SelectedGenus}" Margin="0,0,14,4" />
                    <TextBlock Text="Level" Style="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding SelectedLevel}" Margin="0,0,14,4" />
                    <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding StateOptions}" SelectedItem="{Binding SelectedState}" Margin="0,0,14,4" />
                    <CheckBox Content="has souls" IsChecked="{Binding HasSoulsOnly}" Margin="0,0,14,4" VerticalAlignment="Center" />
                    <CheckBox Content="hide Special" IsChecked="{Binding HideSpecial}" Margin="0,0,14,4" VerticalAlignment="Center" ToolTip="Hide Special pets (cash shop / events) from the list" />
                    <TextBlock Text="Sort" Style="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Margin="0,0,0,4" />
                </WrapPanel>
            </StackPanel>

            <!-- column headers; widths match the row template -->
            <Grid Grid.Row="1" Margin="6,6,6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" MinWidth="170" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Pin" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="1" Text="Pet" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="2" Text="Genus" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="3" Text="Lv" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="4" Text="Progress" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="5" Text="Reg." Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="6" Text="Session" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="7" Text="Link" Style="{StaticResource Muted}" />
            </Grid>

            <ListBox x:Name="PetList" Grid.Row="2" ItemsSource="{Binding View}" SelectedItem="{Binding SelectedRow}"
                     ItemTemplate="{StaticResource PetRow}" ItemContainerStyle="{StaticResource PetItem}"
                     Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
        </Grid>

        <!-- settings tab -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,4,12,0" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="Overlay" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Opacity" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="0.2" Maximum="1" Value="{Binding Model.Opacity}" />
                    <TextBlock Grid.Column="2" Text="{Binding Model.Opacity, StringFormat=P0}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Scale" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="0.6" Maximum="2" Value="{Binding Model.Scale}" />
                    <TextBlock Grid.Column="2" Text="{Binding Model.Scale, StringFormat=P0}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <CheckBox Content="Click-through (the overlay ignores the mouse; undo it with the hotkey or the tray menu)" IsChecked="{Binding Model.ClickThrough}" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="The overlay is its own window. Run the game in borderless windowed mode so the overlay can show above it." />

                <TextBlock Text="Hotkeys" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,6" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Show / hide overlay" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ToggleOverlayText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Toggle click-through" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ToggleClickThroughText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Apply hotkeys" Command="{Binding ApplyHotkeysCommand}" />
                    <TextBlock Text="{Binding HotkeyMessage}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Capture" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,6" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="Adapter override: part of an adapter name, description or IP address (for a VPN or ping reducer). Leave empty for automatic." />
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="300" Text="{Binding AdapterOverride, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Apply and restart capture" Command="{Binding ApplyAdapterCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Text="Data" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,6" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DataFolder}" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                    <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="collection.json, events.jsonl, settings.json and pet-names.json (your own pet names) live here." />
                <Button Content="Reset session stats" Command="{Binding ResetSessionCommand}" HorizontalAlignment="Left" Margin="0,18,0,12" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
