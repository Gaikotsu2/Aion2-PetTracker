<Window x:Class="PetTracker.App.Views.MainWindow" Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:PetTracker.App.Infrastructure"
        Title="Aion 2 Pet Tracker" Width="820" Height="680" MinWidth="640" MinHeight="420"
        Background="{StaticResource SolidPanelBrush}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <infra:EqualsToVisibilityConverter x:Key="SectionVis" />

        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PetItem" TargetType="ListBoxItem">
            <!-- Names come preloaded from the catalog, so renaming lives in the row's context menu (or F2). -->
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Rename..." InputGestureText="F2" Command="{Binding BeginRenameCommand}" />
                        <MenuItem Header="Pin to overlay" IsCheckable="True" IsChecked="{Binding IsPinned}" />
                        <Separator />
                        <MenuItem Header="Open on TH.GL" Command="{Binding OpenLinkCommand}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource RowAltBrush}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewMode" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditMode" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PetRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" MinWidth="170" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding IsPinned}" ToolTip="Pin to overlay" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Style="{StaticResource ViewMode}">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Style="{StaticResource Cell}" />
                        <TextBlock Text="{Binding Id, StringFormat=' #{0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <Border CornerRadius="3" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding SourceTooltip}"
                                Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDungeon}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DungeonBackBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsShop}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ShopBackBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Source}" FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDungeon}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DungeonBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsShop}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ShopBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="needs resync" Foreground="{StaticResource WarnBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding NeedsResync, Converter={StaticResource BoolToVis}}"
                                   ToolTip="An update did not add up. The next login snapshot will fix it." />
                    </StackPanel>
                    <Grid Style="{StaticResource EditMode}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EditBox" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                 IsVisibleChanged="EditBox_IsVisibleChanged">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CommitRenameCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                            <Button Content="save" Style="{StaticResource TinyButton}" Command="{Binding CommitRenameCommand}" />
                            <Button Content="cancel" Style="{StaticResource TinyButton}" Margin="4,0,0,0" Command="{Binding CancelRenameCommand}" />
                        </StackPanel>
                        <Popup IsOpen="{Binding HasSuggestions, Mode=OneWay}" PlacementTarget="{Binding ElementName=EditBox}"
                               Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                            <Border Background="{StaticResource SolidPanelBrush}" BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="1" Padding="2" MinWidth="220">
                                <ItemsControl ItemsSource="{Binding Suggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,1"
                                                    Command="{Binding DataContext.PickSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>

                <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="3" Padding="5,0" Margin="0,0,4,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SpecialBackBrush}" />
                                    <Setter Property="ToolTip" Value="{Binding SpecialTooltip}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Genus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SpecialBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding LevelText}" Style="{StaticResource Cell}" FontWeight="SemiBold" />

                <Grid Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Style="{StaticResource PetBar}" Value="{Binding ProgressFraction, Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" HorizontalAlignment="Right" Style="{StaticResource Cell}" />
                </Grid>

                <TextBlock Grid.Column="5" Text="{Binding RegisteredText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="{Binding SessionGains, StringFormat='+{0}'}" Style="{StaticResource Cell}"
                           Foreground="{StaticResource GoodBrush}" />
                <Button Grid.Column="7" Content="&#x2197;" Style="{StaticResource TinyButton}" Command="{Binding OpenLinkCommand}" ToolTip="{Binding LinkTooltip}" HorizontalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- summary header -->
        <DockPanel Grid.Row="0">
            <Border DockPanel.Dock="Right" Background="{Binding Overlay.StatusBrush}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center" ToolTip="{Binding StatusTooltip}">
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="White" />
            </Border>
            <StackPanel>
                <TextBlock Text="{Binding SummaryText}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SpecialText}" Foreground="{StaticResource SpecialBrush}" Margin="0,2,0,0" ToolTip="Special pets are not counted in Collection Status" />
                <TextBlock Text="{Binding LevelText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1">
        <!-- opcodes moved after a game update: detected by shape, applied only on click -->
        <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="#33E5B341" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                Visibility="{Binding Overlay.ShowDetection, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button Content="Apply" Command="{Binding Overlay.ApplyDetectionCommand}" />
                    <Button Content="Not now" Command="{Binding Overlay.DismissDetectionCommand}" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Overlay.DetectionText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Overlay.DetectionDetail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- capture problem (for example Npcap missing) -->
        <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="#33E5B341" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                Visibility="{Binding HasCaptureProblem, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Get Npcap (npcap.com)" Command="{Binding OpenNpcapCommand}" Margin="10,0,0,0"
                        Visibility="{Binding ShowNpcapBanner, Converter={StaticResource BoolToVis}}" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                    <Run Text="Live capture is not running: " FontWeight="SemiBold" /><Run Text="{Binding CaptureProblem, Mode=OneWay}" />
                    <Run Text=" The collection below is the last saved state." />
                </TextBlock>
            </DockPanel>
        </Border>

        </StackPanel>

        <ListBox Grid.Row="2" Margin="0,10,0,6" Style="{StaticResource Chips}" ItemsSource="{Binding TabOptions}" SelectedItem="{Binding SelectedTab}" />

        <!-- collection tab -->
        <Grid Grid.Row="3" Visibility="{Binding IsCollectionTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <DockPanel Margin="0,0,0,6">
                    <ListBox DockPanel.Dock="Right" Style="{StaticResource Chips}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="Sort" Style="{StaticResource Muted}" Margin="12,0,6,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by name, #id, genus or source (Dungeon / Shop)" />
                </DockPanel>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="clear filters" Command="{Binding ClearFiltersCommand}" Margin="8,0,0,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ShownText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <ToggleButton Style="{StaticResource ExpandToggle}" IsChecked="{Binding FiltersExpanded}" Content="{Binding FiltersToggleText}"
                                  HorizontalAlignment="Left" ToolTip="Show or hide the filters" />
                </DockPanel>

                <!-- filter panel: a label column and wrapping content cells -->
                <Border Background="{StaticResource RowAltBrush}" CornerRadius="4" Padding="10,6,10,2" Margin="0,2,0,0"
                        Visibility="{Binding FiltersExpanded, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Margin" Value="0,0,10,4" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Text="Genus" Style="{StaticResource FilterLabel}" />
                        <ListBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Chips}" ItemsSource="{Binding GenusOptions}" SelectedItem="{Binding SelectedGenus}" Margin="0,0,0,4" />

                        <TextBlock Grid.Row="1" Text="Source" Style="{StaticResource FilterLabel}" />
                        <ListBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Chips}" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}" Margin="0,0,0,4"
                                 ToolTip="Dungeon: drops only in dungeons (for example from bosses). Shop: only sold in a shop." />

                        <TextBlock Grid.Row="2" Text="Level" Style="{StaticResource FilterLabel}" />
                        <WrapPanel Grid.Row="2" Grid.Column="1">
                            <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding SelectedLevel}" Margin="0,0,14,4" />
                            <TextBlock Text="State" Style="{StaticResource FilterLabel}" />
                            <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding StateOptions}" SelectedItem="{Binding SelectedState}" Margin="0,0,0,4" />
                        </WrapPanel>

                        <TextBlock Grid.Row="3" Text="Options" Style="{StaticResource FilterLabel}" />
                        <WrapPanel Grid.Row="3" Grid.Column="1">
                            <CheckBox Content="has souls" IsChecked="{Binding HasSoulsOnly}" Margin="0,0,14,4" VerticalAlignment="Center" />
                            <TextBlock Text="Hide:" Style="{StaticResource FilterLabel}" Margin="0,0,6,4" />
                            <CheckBox Content="Special" IsChecked="{Binding HideSpecial}" Margin="0,0,10,4" VerticalAlignment="Center" ToolTip="Hide Special pets (cash shop / events) from the list" />
                            <CheckBox Content="Dungeon" IsChecked="{Binding HideDungeon}" Margin="0,0,10,4" VerticalAlignment="Center" ToolTip="Hide Dungeon exclusive pets from the list" />
                            <CheckBox Content="Shop" IsChecked="{Binding HideShop}" Margin="0,0,0,4" VerticalAlignment="Center" ToolTip="Hide Shop exclusive pets from the list" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- column headers; widths match the row template. The spacer reserves the list's (always visible)
                 vertical scrollbar so the star column has the same width in the header and in the rows. -->
            <DockPanel Grid.Row="1">
                <Border DockPanel.Dock="Right" Width="{x:Static SystemParameters.VerticalScrollBarWidth}" />
                <Grid Margin="6,6,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" MinWidth="170" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Pin" Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="1" Text="Pet" Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="2" Text="Genus" Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="3" Text="Lv" Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="4" Text="Progress" Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="5" Text="Reg." Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="6" Text="Session" Style="{StaticResource Muted}" />
                    <TextBlock Grid.Column="7" Text="Link" Style="{StaticResource Muted}" />
                </Grid>
            </DockPanel>

            <ListBox x:Name="PetList" Grid.Row="2" ItemsSource="{Binding View}" SelectedItem="{Binding SelectedRow}"
                     ItemTemplate="{StaticResource PetRow}" ItemContainerStyle="{StaticResource PetItem}"
                     Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.InputBindings>
                    <KeyBinding Key="F2" Command="{Binding SelectedRow.BeginRenameCommand}" />
                </ListBox.InputBindings>
            </ListBox>
        </Grid>

        <!-- settings tab: section list on the left, the chosen section's cards on the right -->
        <Grid Grid.Row="3" Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="0,0,1,0" Padding="0,4,10,0">
                <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding SettingsSections}" SelectedItem="{Binding SelectedSettingsSection}" />
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="14,4,8,0">
                <Grid MaxWidth="640" HorizontalAlignment="Left">

                    <!-- General -->
                    <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource SectionVis}, ConverterParameter=General}">
                        <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="When the window is closed" Style="{StaticResource CardTitle}" />
                                <RadioButton GroupName="CloseAction" Content="Minimize to tray (tracking and the overlay keep running)"
                                             IsChecked="{Binding CloseToTray}" />
                                <RadioButton GroupName="CloseAction" Content="Exit the application" IsChecked="{Binding CloseExits}" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,6,0,0"
                                           Text="Applies to the window's close button. Exit in the tray icon's menu always quits." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Startup" Style="{StaticResource CardTitle}" />
                                <CheckBox Content="Start with Windows (minimized: the overlay only, the collection window stays in the tray)"
                                          IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanStartWithWindows}" />
                                <TextBlock Text="{Binding AutoStartMessage}" Style="{StaticResource CardHint}" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,4,0,0"
                                           Text="Adds one value under HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Run. Untick to remove it." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Session" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,8"
                                           Text="Session gains (the Session column and the overlay session figures) count from app start or from the last reset." />
                                <Button Content="Reset session stats" Command="{Binding ResetSessionCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Overlay -->
                    <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource SectionVis}, ConverterParameter=Overlay}">
                        <TextBlock Text="Overlay" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource CardTitle}" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Opacity" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0.2" Maximum="1" Value="{Binding Model.Opacity}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Model.Opacity, StringFormat=P0}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Scale" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0.6" Maximum="2" Value="{Binding Model.Scale}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Model.Scale, StringFormat=P0}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <CheckBox Content="Click-through (the overlay ignores the mouse; undo it with the hotkey or the tray menu)" IsChecked="{Binding Model.ClickThrough}" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,6,0,0"
                                           Text="The overlay is its own window. Run the game in borderless windowed mode so the overlay can show above it." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Hotkeys" Style="{StaticResource CardTitle}" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Show / hide overlay" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding ToggleOverlayText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Toggle click-through" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding ToggleClickThroughText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Apply hotkeys" Command="{Binding ApplyHotkeysCommand}" />
                                    <TextBlock Text="{Binding HotkeyMessage}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Capture -->
                    <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource SectionVis}, ConverterParameter=Capture}">
                        <TextBlock Text="Capture" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Network adapter" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,6"
                                           Text="Adapter override: part of an adapter name, description or IP address (for a VPN or ping reducer). Leave empty for automatic." />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="300" Text="{Binding AdapterOverride, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Apply and restart capture" Command="{Binding ApplyAdapterCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Opcodes -->
                    <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource SectionVis}, ConverterParameter=Opcodes}">
                        <TextBlock Text="Opcodes" Style="{StaticResource SectionTitle}" />
                        <Border Margin="0,0,0,10" Padding="10,8" CornerRadius="6" Background="#33E5B341" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="&#x26A0; Change these only if you know the right values." FontWeight="SemiBold" />
                                <Run Text="A wrong opcode makes the tracker misread or ignore pet packets: level-ups and soul gains can go uncounted, or wrong levels can be written to your collection. After a game update use the values from docs/PATCH-DAY.md. If tracking stops working, click Reset to defaults." />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Opcode overrides" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,8"
                                           Text="Which network opcodes carry which pet message. A game update can renumber them. Override = hex opcodes, comma separated (for example 0990, 1490); leave it empty to use the default. Saving reloads the opcodes at once." />
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Message" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="1" Text="Default" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="2" Text="Override" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="3" Text="In effect" Style="{StaticResource Muted}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding OpcodeRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DefaultText}" VerticalAlignment="Center" FontFamily="Consolas" />
                                                    <TextBox Grid.Column="2" Text="{Binding OverrideText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="3" Text="{Binding EffectiveText}" VerticalAlignment="Center" FontFamily="Consolas" />
                                                </Grid>
                                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="280,2,0,0"
                                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="Save and reload" Command="{Binding SaveOpcodesCommand}" Margin="0,0,8,4" />
                                    <Button Content="Reset to defaults" Command="{Binding ResetOpcodesCommand}" Margin="0,0,8,4" />
                                    <Button Content="Open opcodes.json" Command="{Binding OpenOpcodesFileCommand}" Margin="0,0,8,4" />
                                    <Button Content="Reload from file" Command="{Binding ReloadOpcodesCommand}" Margin="0,0,8,4" />
                                </WrapPanel>
                                <TextBlock Text="{Binding OpcodeMessage}" Style="{StaticResource CardHint}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Data -->
                    <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource SectionVis}, ConverterParameter=Data}">
                        <TextBlock Text="Data" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="PetSouls.dev" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,8"
                                           Text="Send your pet levels to the PetSouls.dev map: copy the code, then on the site open Settings and paste it under Import. Importing on the site replaces that profile's progress." />
                                <WrapPanel>
                                    <Button Content="Copy PetSouls code" Command="{Binding Data.CopyPetSoulsCodeCommand}" Margin="0,0,8,4" />
                                    <Button Content="Save as file..." Command="{Binding Data.SavePetSoulsFileCommand}" Margin="0,0,8,4" />
                                    <Button Content="Open PetSouls.dev &#x2197;" Command="{Binding Data.OpenPetSoulsCommand}" Margin="0,0,8,4" />
                                </WrapPanel>
                                <!-- fades out a few seconds after every change of CopyStatus -->
                                <TextBlock Text="{Binding Data.CopyStatus, NotifyOnTargetUpdated=True}" Opacity="0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CardHint}">
                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Data.IsCopyError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:6" Value="1" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:7.5" Value="0" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>

                                <TextBlock Text="Import from PetSouls.dev" FontWeight="SemiBold" Margin="0,10,0,4" />
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,6"
                                           Text="Paste a code exported from the site, or load its file. Sets pet levels only; the next login snapshot from the game overwrites them with the real state. Your targets and watch list are kept and sent back on the next export." />
                                <TextBox Text="{Binding Data.ImportText, UpdateSourceTrigger=PropertyChanged}" Height="54" TextWrapping="Wrap" AcceptsReturn="False"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="Import code" Command="{Binding Data.ImportPetSoulsCommand}" Margin="0,0,8,4" />
                                    <Button Content="Load file..." Command="{Binding Data.LoadPetSoulsFileCommand}" Margin="0,0,8,4" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Data.PetSoulsMessage}" Style="{StaticResource CardHint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Backup &amp; restore" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,8"
                                           Text="One file with the collection, your own pet names, pins, overlay look, hotkeys and adapter. The event history (events.jsonl) is not included. Before every import or restore the current state is saved to the backups folder." />
                                <WrapPanel>
                                    <Button Content="Export backup..." Command="{Binding Data.ExportBackupCommand}" Margin="0,0,8,4" />
                                    <Button Content="Restore backup..." Command="{Binding Data.RestoreBackupCommand}" Margin="0,0,8,4" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Data.BackupMessage}" Style="{StaticResource CardHint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Storage" Style="{StaticResource CardTitle}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="10,0,0,0" />
                                    <TextBlock Text="{Binding DataFolder}" VerticalAlignment="Center" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,6,0,0"
                                           Text="collection.json, events.jsonl, settings.json, pet-names.json (your own pet names), the backups folder and the logs folder (diagnostic logs, kept 3 days) live here." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Diagnostics -->
                    <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource SectionVis}, ConverterParameter=Diagnostics}">
                        <TextBlock Text="Diagnostics" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="What the tracker sees right now" Style="{StaticResource CardTitle}" />
                                <ItemsControl ItemsSource="{Binding Diagnostics.Chips}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" MinWidth="130" CornerRadius="10" Padding="10,2" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource RowBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDim}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LevelName}" Value="Good">
                                                                    <Setter Property="Background" Value="{StaticResource GoodBackBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource GoodBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LevelName}" Value="Warn">
                                                                    <Setter Property="Background" Value="{StaticResource WarnBackBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LevelName}" Value="Bad">
                                                                    <Setter Property="Background" Value="{StaticResource BadBackBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource CardHint}" Margin="10,0,0,0"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Getting help: send a diagnostic report" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardHint}" TextWrapping="Wrap"
                                           Text="1. Start the game and leave the tracker running while the problem happens (log in and wait a minute or two). If it stays empty, that is the most useful case to capture.&#x0A;2. Click Save report... below.&#x0A;3. Attach the saved .txt file to your support request, or paste it with Copy report." />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Save report..." Command="{Binding Diagnostics.SaveReportCommand}" Margin="0,0,8,4" />
                                    <Button Content="Copy report" Command="{Binding Diagnostics.CopyReportCommand}" Margin="0,0,8,4" />
                                    <Button Content="Open logs folder" Command="{Binding Diagnostics.OpenLogsFolderCommand}" Margin="0,0,8,4" />
                                    <Button Content="Clear logs" Command="{Binding Diagnostics.ClearLogsCommand}" Margin="0,0,8,4" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Diagnostics.Message}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CardHint}">
                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Diagnostics.MessageIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Your privacy" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardHint}" TextWrapping="Wrap"
                                           Text="The log holds technical events only: versions, Npcap and adapter checks, whether the game was found, connection and decoder counters, and opcode numbers. It never contains packet contents, pet names, account or character data. IP addresses are replaced by tokens like ip#1(public), and your Windows user name, computer name and profile folders are removed. Nothing is sent anywhere: you decide whether to share the file. Log files older than 3 days are deleted automatically." />
                                <TextBlock Text="{Binding Diagnostics.LogsFolder}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding Diagnostics.RefreshCommand}" />
                                    <TextBlock Text="Log preview (latest lines, exactly what a report contains)" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBox Text="{Binding Diagnostics.Preview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                         Height="220" Margin="0,8,0,0" TextWrapping="NoWrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- About -->
                    <StackPanel Visibility="{Binding SelectedSettingsSection, Converter={StaticResource SectionVis}, ConverterParameter=About}">
                        <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardHint}"
                                           Text="Passive packet reader: it never touches the game process. Pet data credit: TH.GL (aion2.th.gl). After a game update see docs/PATCH-DAY.md." />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="GitHub repository &#x2197;" Command="{Binding OpenRepoCommand}" Margin="0,0,8,4" />
                                </WrapPanel>
                                <TextBlock Text="Source code, releases and issue reports: github.com/Gaikotsu2/Aion2-PetTracker" Style="{StaticResource CardHint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Support the project (optional)" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardHint}"
                                           Text="Aion 2 Pet Tracker is free and open source. If you find it useful and want to say thanks, you can leave a tip on Ko-fi. Tipping is entirely optional: every feature works exactly the same whether or not you tip, with no locked features, reminders or supporter perks." />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Tip on Ko-fi &#x2197;" Command="{Binding OpenKofiCommand}" Margin="0,0,8,4" />
                                </WrapPanel>
                                <TextBlock Text="ko-fi.com/gaikotsu2" Style="{StaticResource CardHint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Legal" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardHint}"
                                           Text="Copyright &#x00A9; 2026 Gaikotsu2. Released under the MIT License (see the LICENSE file)." />
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,6,0,0"
                                           Text="AION is a registered trademark of NCSOFT Corporation. Aion 2 Pet Tracker is an unofficial fan tool and is not affiliated with, endorsed by or sponsored by NCSOFT. All other trademarks belong to their respective owners." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
